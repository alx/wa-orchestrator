[Unit]
Description=wa-orchestrator dashboard (scoped beads + bot activity, :8093)
# TEMPLATE — substitute <HOME> and <NODE_BIN> before install (see
# wa-orchestrator.service for what they mean).

[Service]
Type=simple
WorkingDirectory=<HOME>/code/wa-orchestrator
ExecStart=<NODE_BIN> <HOME>/code/wa-orchestrator/dashboard.js
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
