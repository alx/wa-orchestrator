{
  "name": "wa-orchestrator",
  "version": "0.2.0",
  "description": "Multi-group WhatsApp orchestrator: one process, one WhatsApp account, N groups, one pi-agent brain per group (docker-sandboxed).",
  "main": "dist/index.js",
  "bin": {
    "wa-orchestrator": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "xvfb-run -a node dist/index.js",
    "dashboard": "node dist/dashboard.js",
    "discover": "xvfb-run -a node dist/discover.js",
    "build-sandbox": "bash sandbox/build.sh",
    "test": "node --test test/*.test.js",
    "test-brain": "node dist/test-brain.js"
  },
  "keywords": [
    "pi-package",
    "pi",
    "whatsapp",
    "wwebjs",
    "bot",
    "orchestrator",
    "docker"
  ],
  "pi": {
    "skills": [
      "skills/wa-orchestrator"
    ]
  },
  "files": [
    "dist",
    "src",
    "config.template.json",
    "brain-prompts.template.json",
    "sandbox/Dockerfile",
    "sandbox/build.sh",
    "skills",
    "wa-orchestrator.service",
    "wa-orchestrator-dashboard.service",
    "docs",
    "README.md",
    "test"
  ],
  "author": "Alexandre Girard Davila <git@alexgirard.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
