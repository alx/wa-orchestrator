{
  "name": "wa-orchestrator",
  "version": "0.1.0",
  "description": "Multi-group WhatsApp orchestrator: one process, one WhatsApp account, N groups, one pi-agent brain per group (docker-sandboxed).",
  "main": "index.js",
  "bin": {
    "wa-orchestrator": "index.js"
  },
  "scripts": {
    "start": "xvfb-run -a node index.js",
    "dashboard": "node dashboard.js",
    "discover": "xvfb-run -a node discover.js",
    "build-sandbox": "bash sandbox/build.sh",
    "test-brain": "node test-brain.js"
  },
  "keywords": [
    "pi-package",
    "pi",
    "whatsapp",
    "wwebjs",
    "bot",
    "orchestrator",
    "docker"
  ],
  "pi": {
    "skills": [
      "skills/wa-orchestrator"
    ]
  },
  "files": [
    "index.js",
    "brain.js",
    "groups.js",
    "dashboard.js",
    "discover.js",
    "list-groups.js",
    "test-brain.js",
    "config.template.json",
    "sandbox/Dockerfile",
    "sandbox/build.sh",
    "skills",
    "wa-orchestrator.service",
    "wa-orchestrator-dashboard.service",
    "docs",
    "README.md"
  ],
  "author": "Alexandre Girard Davila <git@alexgirard.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  }
}
