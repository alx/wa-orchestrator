[Unit]
Description=wa-orchestrator — multi-group WhatsApp orchestrator (wwebjs client + sandboxed pi brains)
# USER-scoped unit (installed to ~/.config/systemd/user/). The user has
# Linger=yes, so it runs without a login session.
# One WhatsApp account, N registered groups, one brain per group.
# Never run two instances at once (one client per WhatsApp account).
#
# TEMPLATE — substitute before install:
#   <HOME>        → your absolute home dir, e.g. /home/<you>
#   <NODE_BIN>    → absolute path to the node binary that runs on PATH here

[Service]
Type=simple
WorkingDirectory=<HOME>/code/wa-orchestrator
# Compiled output — `npm run build` (tsc) produces dist/ from src/*.ts.
ExecStart=/bin/bash -c 'exec xvfb-run -a <NODE_BIN> <HOME>/code/wa-orchestrator/dist/index.js'
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
