{
  "_comment": "wa-orchestrator configuration TEMPLATE. Copy to config.json and fill in every <PLACEHOLDER>. Paths must be ABSOLUTE (no ~ expansion at runtime). Keep config.json out of git (it is gitignored).",
  "groups": [
    { "jid": "<GROUP_JID_1>", "name": "Group A", "brain": "beads-project" },
    { "jid": "<GROUP_JID_2>", "name": "Group B", "brain": "site-project" }
  ],
  "triggerPrefix": "pi ",
  "botPrefix": "🤖 ",
  "ackMessage": "🤖 on it — the brain is thinking…",
  "dryRun": false,
  "sessionsDir": "<HOME>/code/wa-orchestrator/sessions",
  "wwebjsCacheDir": "<HOME>/code/wa-orchestrator/.wwebjs_cache",
  "chromiumPath": "/usr/bin/chromium",
  "activityLog": "<HOME>/code/wa-orchestrator/activity/activity.jsonl",
  "activityMaxBytes": 1048576,
  "replyTimeoutMs": 300000,
  "runTimeoutMs": 900000,
  "sandboxImage": "wa-orchestrator-sandbox",
  "modelLock": "<MODEL_LOCK_ID>",
  "provider": "<PROVIDER>",
  "hostPiAgentDir": "<HOME>/.pi/agent",
  "piConfigDir": "<HOME>/code/wa-orchestrator/sandbox/pi-config",
  "workDir": "<HOME>/code/wa-orchestrator/sandbox/work",
  "brains": {
    "beads-project": {
      "kind": "beads",
      "botName": "Project Bot",
      "conversationDir": "<HOME>/code/wa-orchestrator/conversations/beads-project",
      "beadsRepoDir": "<ABS_PATH_TO_BEADS_REPO>",
      "beadsLabel": "<BEADS_LABEL>",
      "beadsParentEpic": "<PARENT_EPIC_ID>",
      "runCmd": "run",
      "artifactRepoDir": "<ABS_PATH_TO_PROJECT_GIT_REPO>",
      "defaultAsk": "List the current open beads."
    },
    "site-project": {
      "kind": "cpo",
      "botName": "Site Bot",
      "conversationDir": "<HOME>/code/wa-orchestrator/conversations/site-project",
      "beadsRepoDir": "<ABS_PATH_TO_LIVE_BEADS_DB>",
      "epics": ["<EPIC_ID_1>", "<EPIC_ID_2>"],
      "runCmd": "edit",
      "defaultAsk": "List the open project beads.",
      "siteDir": "<ABS_PATH_TO_SITE_CHECKOUT>",
      "siteBuildCmd": "<SITE_BUILD_COMMAND>",
      "siteLiveUrl": "https://<SITE_URL>"
    }
  },
  "gitHomeDir": "<HOME>/code/wa-orchestrator/sandbox/git-home",
  "hostGitCredentials": "<HOME>/.git-credentials",
  "gitIdentity": {
    "name": "<COMMITTER_NAME>",
    "email": "<COMMITTER_EMAIL>"
  }
}
